# Supabase Postgres（股价 / 宏观序列 / 回测 / 交易记录持久化）
DATABASE_URL=postgresql://user:password@db.xxx.supabase.co:5432/postgres

# 事件推送（可选，均不配置则不推送）。
# ALERT_WEBHOOK_URL 收 {text, asOf, regime, trades} 任意 JSON；DISCORD_WEBHOOK_URL 收 {content} Discord 格式。
# 执行器在财报避险生效或发生成交的轮次推送，体制切换类事件由预告数据反映在站点上。
ALERT_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# 真实账本导入（npm run import-real）的初始资金，默认 10000
REAL_START_CASH=10000
