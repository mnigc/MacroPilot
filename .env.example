# 币安 Web3 API（dev-portal 申请，黑客松报名后活动期免费）
BINANCE_API_KEY=
BINANCE_SECRET_KEY=

# 执行模式：paper（默认，纸面成交）| live（主网 RFQ 真实下单）
EXECUTION_MODE=paper

# BSC 钱包（live 模式必须；纸面模式不需要）
# 强烈建议使用专用新钱包，只放小额资金
WALLET_PRIVATE_KEY=
PORTFOLIO_ADDRESS=

# BSC RPC（默认公共节点，可换成自己的）
BSC_RPC_URL=https://bsc-dataseed.binance.org
