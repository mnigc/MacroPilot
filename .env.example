# Binance Web3 API (dev-portal; free quota during the hackathon)
BINANCE_API_KEY=
BINANCE_SECRET_KEY=

# Execution mode: paper (default, simulated fills) | live (mainnet orders)
EXECUTION_MODE=paper

# BSC wallet (required for live mode only; use a dedicated wallet with small funds)
WALLET_PRIVATE_KEY=
# Optional. Only used as the quoting address for npm run smoke/spread;
# when empty those scripts quote with a throwaway address they generate locally.
PORTFOLIO_ADDRESS=

# BSC RPC endpoint
BSC_RPC_URL=https://bsc-dataseed.binance.org

# Supabase Postgres (prices/signals/backtest persistence)
DATABASE_URL=postgresql://user:password@db.xxx.supabase.co:5432/postgres
