{
  "name": "macro-pilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm --prefix web run dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "tsx scripts/smoke.ts",
    "spread": "tsx scripts/spread.ts",
    "candles": "tsx scripts/candles.ts",
    "reconcile": "tsx scripts/reconcile.ts",
    "wallet": "tsx scripts/wallet.ts",
    "wallet:new": "tsx scripts/new-wallet.ts --save",
    "backtest": "tsx scripts/backtest.ts",
    "agent": "tsx src/run-once.ts",
    "web:build": "npm --prefix web run build",
    "preview": "npm --prefix web run preview"
  },
  "dependencies": {
    "dotenv": "^17.2.1",
    "pg": "^8.23.0",
    "undici": "^8.11.2",
    "viem": "^2.32.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
