---
import "../styles/global.css";
const { active = "", title = "MacroPilot · 代币化股票智能投顾" } = Astro.props;
const items = [
  { href: "/", label: "仪表盘", key: "dash" },
  { href: "/backtest", label: "回测", key: "backtest" },
  { href: "/trades", label: "交易记录", key: "trades" },
  { href: "/spread", label: "链上溢价", key: "spread" },
];
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <nav class="nav">
      <div class="nav-inner">
        <a href="/" class="logo">
          <span class="mark">◆</span>
          MacroPilot<small>BNB Hack · 代币化股票专题</small>
        </a>
        {items.map((it) => <a href={it.href} class:list={["item", { active: active === it.key }]}>{it.label}</a>)}
      </div>
    </nav>
    <div class="container">
      <slot />
      <div class="footer">
        <span>MacroPilot — 定投 · 体制 · 漂移 · 财报，四引擎共享一个链上执行器</span>
        <span>纸面数据，不构成投资建议 · <a href="https://github.com/mnigc/macro-bnbchain" style="color:var(--text-2)">GitHub</a></span>
      </div>
    </div>
  </body>
</html>
