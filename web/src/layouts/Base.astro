---
import "../styles/global.css";
import { getLatestRun, getFreshness, getTickerBoard } from "../lib/db";

const { active = "", crumb = "", sub = "", title = "MacroPilot · 全球股票智能投顾" } = Astro.props;

const run = await getLatestRun();
const tickers: string[] = run?.tickers ?? [];
const [board, fresh] = await Promise.all([getTickerBoard(tickers), getFreshness()]);

const items = [
  {
    href: "/", key: "dash", label: "投顾仪表盘",
    icon: '<path d="M3 3h7v7H3zM14 3h7v4h-7zM14 10h7v11h-7zM3 13h7v8H3z"/>',
  },
  {
    href: "/backtest", key: "backtest", label: "回测实验室",
    icon: '<path d="M3 3v18h18"/><path d="M7 15l4-5 3 3 5-7"/>',
  },
  {
    href: "/trades", key: "trades", label: "交易流水",
    icon: '<path d="M4 6h16M4 12h16M4 18h10"/><circle cx="19" cy="18" r="1.4"/>',
  },
  {
    href: `/ticker/${tickers[0] ?? "AAPL"}`, key: "ticker", label: "标的走势",
    icon: '<path d="M3 20.5h18"/><path d="M8 3.5v3M8 16.5v3M5.8 6.5h4.4v10H5.8z"/><path d="M16.5 8v2.5M16.5 16.5v2M14.3 10.5h4.4v6h-4.4z"/>',
  },
];

const chgPct = (c: number, p: number | null) => (p ? c / p - 1 : null);
const fmtPct = (v: number, d = 2) => `${v >= 0 ? "+" : ""}${(v * 100).toFixed(d)}%`;

/** 滞后超过 4 天的源要显式标黄——"永不停歇"必须能被证伪 */
const lagDays = (asOf: string | null) => (asOf ? Math.floor((Date.now() - Date.parse(asOf + "T23:59:59Z")) / 86_400_000) : 999);
/**
 * 执行器心跳：runtime_state 每轮都会写，所以这个"距今多久"才是"永不停歇"的可核对读数；
 * 只显示数据日 as_of 会掩盖"守卫拦下、今天根本没跑"这种状态。按日频节拍定阈值：
 * 超过 30h 说明漏了一轮，超过 54h 说明连着两轮没跑。
 */
const execAge = fresh.agent.at ? (Date.now() - Date.parse(fresh.agent.at)) / 3_600_000 : Infinity;
const execCls = execAge > 54 ? "down" : execAge > 30 ? "yel" : "";
const execLabel = !fresh.agent.at
  ? "未运行"
  : execAge < 1
    ? `${Math.round(execAge * 60)} 分钟前`
    : execAge < 48
      ? `${execAge.toFixed(0)} 小时前`
      : `${(execAge / 24).toFixed(1)} 天前`;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content="MacroPilot — 宏观体制驱动的全球股票投资平台" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body>
    <div class="app">
      <aside class="side">
        <div class="brand">
          <svg class="brand-mark" viewBox="0 0 64 64" aria-hidden="true">
            <defs>
              <linearGradient id="bm-gold" x1="6" y1="2" x2="58" y2="62" gradientUnits="userSpaceOnUse">
                <stop offset="0" stop-color="#FDE04B"/><stop offset="0.55" stop-color="#FCD535"/><stop offset="1" stop-color="#E8A600"/>
              </linearGradient>
            </defs>
            <rect width="64" height="64" rx="15" fill="url(#bm-gold)"/>
            <path d="M12.5 47.5 25 27 35 38.5 48 23" fill="none" stroke="#0A0C10" stroke-width="7" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M55.4 14.2 54.3 28.3 41.7 17.7Z" fill="#0A0C10"/>
          </svg>
          <span class="brand-txt">MacroPilot<small>全球股票 · 智能投顾</small></span>
        </div>

        <nav class="nav-group">
          <div class="nav-cap">策略</div>
          {items.map((it) => (
            <a href={it.href} class:list={["nav-item", { active: active === it.key }]}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={it.icon} />
              {it.label}
            </a>
          ))}
        </nav>

        <div class="side-foot">
          <div class="kv"><span class="k">执行模式</span><span class="v"><b class="yel">{fresh.agent.mode ?? "paper"}</b></span></div>
          <div class="kv"><span class="k">执行器</span><span class:list={["v", execCls]} title={fresh.agent.at ? `最后心跳 ${fresh.agent.at} · 决策数据日 ${fresh.agent.asOf}` : "runtime_state 无记录"}>{execLabel}</span></div>
          <div class="kv"><span class="k">股价</span><span class:list={["v", lagDays(fresh.prices.asOf) > 4 && "down"]}>{fresh.prices.asOf ?? "—"}</span></div>
          <div class="kv"><span class="k">宏观</span><span class="v">{fresh.macro.asOf ?? "—"}</span></div>
        </div>
      </aside>

      <div class="main">
        <header class="topbar">
          <div class="topbar-in">
            <div class="crumb">
              <h1>{crumb}</h1>
              <span class="sub">{sub}</span>
            </div>
            <div class="topbar-r">
              <slot name="actions" />
            </div>
          </div>
          {board.length > 0 && (
            <div class="strip" data-marquee="off">
              {[[0, false], [1, true]].map(([pass, hidden]) => (
                <div class="strip-track" aria-hidden={hidden ? "true" : undefined}>
                  {board.map((b) => {
                    const ch = chgPct(b.close, b.prevClose);
                    return (
                      <a class="strip-item" href={`/ticker/${b.ticker}`}>
                        <span class="s">{b.ticker}</span>
                        <span class="p">{b.close.toFixed(2)}</span>
                        <span class:list={["d", ch === null ? "dim" : ch >= 0 ? "up" : "down"]}>{ch === null ? "—" : fmtPct(ch)}</span>
                      </a>
                    );
                  })}
                </div>
              ))}
            </div>
          )}
        </header>

        <main class="content">
          <slot />
          <div class="foot">
            <span>MacroPilot — 定投 · 体制 · 漂移 · 财报，四引擎共享一个纸面执行器 · 回测 run #{run?.id ?? "—"}</span>
            <span>纸面数据，不构成投资建议 · <a href="https://github.com/mnigc/macro-bnbchain" class="dim" style="text-decoration:underline">GitHub</a></span>
          </div>
        </main>
      </div>
    </div>
    <script>
      /**
       * 行情条 marquee：单轮宽度不足视口时右侧会露白，所以先把条目补齐到 ≥1.5 轮，
       * 再按固定像素速度换算动画时长——两条 track 各位移自身宽度的 100% 即无缝循环。
       */
      const strip = document.querySelector<HTMLElement>(".strip[data-marquee]");
      const tracks = strip ? Array.from(strip.querySelectorAll<HTMLElement>(".strip-track")) : [];
      if (strip && tracks.length === 2) {
        const [head, tail] = tracks;
        const proto = Array.from(head.children) as HTMLElement[];
        const addOnce = () => {
          for (const src of [...proto]) {
            for (const track of tracks) {
              const c = src.cloneNode(true) as HTMLElement;
              c.setAttribute("aria-hidden", "true");
              c.setAttribute("tabindex", "-1");
              track.appendChild(c);
            }
          }
        };
        let guard = 0;
        while (head.scrollWidth < strip.clientWidth * 1.5 && guard++ < 8) addOnce();
        if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
          strip.style.setProperty("--strip-dur", `${Math.max(28, head.scrollWidth / 42).toFixed(1)}s`);
          strip.dataset.marquee = "on";
        }
      }
    </script>
    <script>
      /**
       * 长表分页。静态站点没有服务端，切片只能在前端做：给 <table data-paginate> 用，
       * 每页行数取 data-page-size（默认 20），可切 20 / 50 / 100 / 全部。
       *
       * 和外部筛选共存：筛选（交易流水的引擎标签）用 row.hidden，本脚本用 .pg-hide，
       * 两套隐藏互不覆盖；筛选变化由 MutationObserver 接住，并退回第 1 页。
       * "暂无记录"那类 colspan 占位行不参与分页，始终显示。
       */
      const PG_SIZES: { v: number; label: string }[] = [
        { v: 20, label: "20" },
        { v: 50, label: "50" },
        { v: 100, label: "100" },
        { v: Infinity, label: "全部" },
      ];

      /** 页码窗口：首尾 + 当前页 ±1，中间折成省略号 */
      function pgPages(cur: number, pages: number): (number | null)[] {
        const out: (number | null)[] = [];
        for (let p = 1; p <= pages; p++) {
          if (p === 1 || p === pages || Math.abs(p - cur) <= 1) {
            if (out[out.length - 1] !== p) out.push(p);
          } else if (out[out.length - 1] !== null) out.push(null);
        }
        return out;
      }

      function setupPager(table: HTMLTableElement): void {
        const tbody = table.tBodies[0];
        if (!tbody) return;
        const rows = Array.from(tbody.rows).filter((r) => !r.querySelector("td.empty, td[colspan]"));
        if (rows.length === 0) return;

        let size = Number(table.dataset.pageSize) || PG_SIZES[0].v;
        let page = 1;

        const bar = document.createElement("div");
        bar.className = "pager";
        table.insertAdjacentElement("afterend", bar);

        const render = (reset = false): void => {
          const pool = rows.filter((r) => !r.hidden);
          const pages = size === Infinity ? 1 : Math.max(1, Math.ceil(pool.length / size));
          if (reset) page = 1;
          page = Math.min(Math.max(1, page), pages);

          const start = size === Infinity ? 0 : (page - 1) * size;
          const end = size === Infinity ? pool.length : Math.min(start + size, pool.length);
          const slice = pool.slice(start, end);
          const onPage = new Set(slice);
          for (const r of rows) {
            r.classList.toggle("pg-hide", !onPage.has(r));
            r.classList.remove("pg-last");
          }

          // 一页装得下就不摆控件；但要保住"每页行数"下拉，所以阈值取最小档
          bar.hidden = pool.length <= PG_SIZES[0].v;
          bar.replaceChildren();
          if (bar.hidden) return;
          slice[slice.length - 1]?.classList.add("pg-last");

          const info = document.createElement("span");
          info.className = "pg-info";
          info.textContent = `${start + 1}–${end} / ${pool.length}`;

          const btns = document.createElement("div");
          btns.className = "pg-btns";
          const add = (label: string, o: { on?: boolean; off?: boolean; go?: () => void }) => {
            const b = document.createElement("button");
            b.type = "button";
            b.textContent = label;
            if (o.on) b.classList.add("on");
            if (o.on) b.setAttribute("aria-current", "page");
            if (o.off) b.disabled = true;
            if (o.go) b.addEventListener("click", o.go);
            btns.appendChild(b);
          };

          add("‹", { off: page <= 1, go: () => { page--; render(); } });
          for (const p of pgPages(page, pages)) {
            if (p === null) {
              const gap = document.createElement("span");
              gap.className = "pg-gap";
              gap.textContent = "…";
              btns.appendChild(gap);
            } else {
              add(String(p), { on: p === page, go: () => { page = p; render(); } });
            }
          }
          add("›", { off: page >= pages, go: () => { page++; render(); } });

          const sel = document.createElement("select");
          sel.setAttribute("aria-label", "每页行数");
          for (const s of PG_SIZES) {
            const o = document.createElement("option");
            o.value = String(s.v);
            o.textContent = s.label;
            if (s.v === size) o.selected = true;
            sel.appendChild(o);
          }
          sel.addEventListener("change", () => {
            size = sel.value === "Infinity" ? Infinity : Number(sel.value);
            render(true);
          });

          bar.append(info, btns, sel);
        };

        // 筛选改的是 row.hidden；只观察这一个属性，本脚本改的 .pg-hide 不会反过来触发
        new MutationObserver(() => render(true)).observe(tbody, {
          subtree: true,
          attributes: true,
          attributeFilter: ["hidden"],
        });

        render();
      }

      for (const t of document.querySelectorAll<HTMLTableElement>("table[data-paginate]")) setupPager(t);
    </script>
  </body>
</html>
