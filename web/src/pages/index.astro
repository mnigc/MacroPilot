---
import Base from "../layouts/Base.astro";
import { ScoreChart } from "../components/charts";
import { regimeBands, REGIME_LABEL } from "../lib/bands";
import { DRIVER_LABEL, parseDrivers } from "../lib/drivers";
import { getEngineState, fmtUsd, fmtPct } from "../lib/engineState";
import { getMacroReadings, getExecutorRun } from "../lib/db";

/** 账户与引擎状态统一走共享模块——策略引擎页读的是同一份，口径不会跑偏 */
const {
  e, run, regimePoints, latest, cover, nextEarn, earnWindow, inWindow, paperTrades, preview,
  nextEarnLabel, nextFriday, dcaCount, score, regime, edge,
  equity, startCash, pnl, cash, cashWeight, cashTarget, targetEach, rows, missingPx,
} = await getEngineState();
const bands = regimeBands(regimePoints.map((p) => p.date), regimePoints.map((p) => p.regime));

const macro = await getMacroReadings();
const executor = await getExecutorRun("paper");

const sigMeta = [
  { key: "liquidity", name: "流动性", series: "WALCL", w: e.regime.signals.liquidity.weight, desc: "联储资产负债表规模 13 周变化（扩表加分）", fmt: (v: number) => `${(v / 1000).toFixed(0)} 十亿$` },
  { key: "volatility", name: "波动率", series: "VIXCLS", w: e.regime.signals.volatility.weight, desc: "VIX 水平 70% + 1 月趋势 30%（低波动加分）", fmt: (v: number) => v.toFixed(2) },
  { key: "rates", name: "利率", series: "DGS10", w: e.regime.signals.rates.weight, desc: "10Y 收益率 13 周变化（下行加分）", fmt: (v: number) => `${v.toFixed(2)}%` },
  { key: "trend", name: "趋势", series: "SP500", w: e.regime.signals.trend.weight, desc: "标普 500 相对 200 日均线的位置", fmt: (v: number) => v.toFixed(0) },
  { key: "credit", name: "信用", series: "BAMLH0A0HYM2", w: e.regime.signals.credit?.weight ?? 0.2, desc: "高收益信用利差：水平 70% + 13 周变化 30%（收紧减分）", fmt: (v: number) => `${v.toFixed(2)}pp` },
] as const;

const sigColor = (v: number) => (v >= 0.6 ? "up" : v <= 0.4 ? "down" : "yel");
const sigValues: Record<string, number> = latest ? { ...latest.signals } : {};

const execAgeH = executor ? (Date.now() - Date.parse(executor.at)) / 3_600_000 : null;
const execChip = execAgeH === null ? "" : execAgeH <= 30 ? "ok" : execAgeH <= 54 ? "warn" : "bad";
const execAgeLabel = execAgeH === null ? "未运行" : execAgeH < 1 ? `${Math.round(execAgeH * 60)} 分钟前` : execAgeH < 48 ? `${execAgeH.toFixed(0)} 小时前` : `${(execAgeH / 24).toFixed(1)} 天前`;
---
<Base active="dash" crumb="投顾仪表盘" sub="六模块 → 一张目标权重表 → 一个纸面执行器">
  <div slot="actions" class="stack" style="flex-direction:row;gap:8px">
    <span class:list={["badge", regime]}><span class="dot"></span>{REGIME_LABEL[regime]} · {score.toFixed(3)}</span>
    <span class="chip">纸面账户</span>
  </div>

  <div class="tiles">
    <div class="tile">
      <div class="tile-k">Paper 组合净值</div>
      <div class="tile-v">{fmtUsd(equity)}</div>
      <div class="tile-s"><span class:list={["delta", pnl >= 0 ? "up" : "down"]}>{pnl >= 0 ? "▲" : "▼"} {fmtPct(Math.abs(pnl), 2)}</span> vs 初始 {fmtUsd(startCash)}</div>
      {missingPx.length > 0 && <div class="tile-s" style="color:var(--down)">⚠ {missingPx.join("、")} 无最新行情，该持仓按 0 计——先跑价格同步</div>}
    </div>
    <div class="tile">
      <div class="tile-k">目标股票仓位</div>
      <div class="tile-v yel">{((latest?.equity_target ?? 0) * 100).toFixed(0)}%</div>
      <div class="tile-s">体制档 {(e.regime.allocation.riskOn * 100).toFixed(0)}% / {(e.regime.allocation.neutral * 100).toFixed(0)}% / {(e.regime.allocation.riskOff * 100).toFixed(0)}% · 合成 {preview ? `${((preview.composition.final ?? 0) * 100).toFixed(0)}%` : "—"}</div>
    </div>
    <div class="tile">
      <div class="tile-k">资金分布 · 股票 / 现金</div>
      <div class="tile-v sm">{fmtUsd(equity - cash)} <span class="faint">/</span> {fmtUsd(cash)}</div>
      <div class="bar lg" style="margin-top:8px"><i style={`width:${((equity - cash) / (equity || 1)) * 100}%`}></i></div>
    </div>
    <div class="tile">
      <div class="tile-k">下次定投</div>
      <div class="tile-v sm">{nextFriday}</div>
      <div class="tile-s">周五注入 {fmtUsd(e.dca.amountUsdt)} · 已执行 {dcaCount} 次</div>
    </div>
    <div class="tile">
      <div class="tile-k">最近一场财报</div>
      <div class="tile-v sm">{nextEarnLabel}</div>
      <div class="tile-s">{nextEarn[0]?.date ?? "日历未同步"} · 窗口 {e.earnings.riskOffDaysBefore} 天</div>
    </div>
  </div>

  {cover.rows === 0 && (
    <div class="note bad" style="margin-top:12px">
      <span class="ic">⚠</span>
      <div><b>财报日历为空</b>（earnings_dates 0 行）——财报引擎不会触发，任何"无临近财报"的读数都不成立。运行 <code>python scripts/sync-prices.py --earnings-only</code> 或由 sync-data workflow 同步。</div>
    </div>
  )}

  <div class="grid g-32" style="margin-top:12px">
    <div class="panel">
      <div class="panel-hd">
        <h2>宏观体制</h2><span class="hint">综合分 = 四信号百分位加权 · 三态滞回</span>
        <div class="right"><span class="faint">截至 {latest?.date ?? "—"}</span></div>
      </div>
      <div class="panel-bd grow">
        <div class="gauge">
        <div class="gauge-score">
          <span class="big">{score.toFixed(3)}</span>
          <span class:list={["badge", regime]}><span class="dot"></span>{REGIME_LABEL[regime]}</span>
          {preview?.gateActive && <span class="chip bad" title={`Sahm 规则读数 ${preview.sahm?.toFixed(2)}pp ≥ 阈值（失业率 3 个月均值 − 12 个月低点）`}>⚠ Sahm 门 · 仓位压回防御档</span>}
          <span class="faint" style="margin-left:auto">{edge.label} <b class="mono">{edge.v.toFixed(3)}</b></span>
        </div>
          <div class="gauge-track">
            <div class="gauge-needle" style={`left:${Math.max(0, Math.min(100, score * 100))}%`}></div>
          </div>
          <div class="gauge-scale">
            <span style="left:0%">0</span>
            <span style={`left:${e.regime.scoreLow * 100}%`}><b>{e.regime.scoreLow.toFixed(2)}</b>risk-off ≤</span>
            <span style={`left:${e.regime.scoreRelease * 100}%`}><b>{e.regime.scoreRelease.toFixed(2)}</b>回落内沿</span>
            <span style={`left:${e.regime.scoreHigh * 100}%`}><b>{e.regime.scoreHigh.toFixed(2)}</b>risk-on ≥</span>
            <span style="left:97%">1</span>
          </div>
        </div>
        <div class="sep"></div>
        <div class="faint" style="margin-bottom:6px">近 180 天综合分与体制色带（绿=risk-on · 蓝=中性 · 红=risk-off）</div>
        <ScoreChart
          client:load
          points={regimePoints.slice(-180).map((p) => ({ date: p.date, score: p.score }))}
          bands={bands.filter((b) => b.end >= (regimePoints.at(-180)?.date ?? "9999"))}
          scoreHigh={e.regime.scoreHigh}
          scoreLow={e.regime.scoreLow}
          scoreRelease={e.regime.scoreRelease}
          short
          fill
        />
      </div>
    </div>

    <div class="panel">
      <div class="panel-hd"><h2>信号分量</h2><span class="hint">百分位 + 原始读数</span></div>
      <div class="panel-bd">
        {sigMeta.map((s) => {
          // 老 run 缺该信号时不造数：不画条、显示 —（0 分在语义上是"极度收紧"）
          const v = sigValues[s.key];
          const hasV = v !== undefined && v !== null;
          const m = macro[s.series];
          const chg = m?.prevQ ? m.value / m.prevQ - 1 : null;
          return (
            <div class="sig" style="grid-template-columns:88px 1fr 46px 132px">
              <div class="n">{s.name}<em>权重 {fmtPct(s.w, 0)}</em></div>
              <div class="bar lg"><i style={`width:${hasV ? v * 100 : 0}%;background:${hasV ? `var(--${v >= 0.6 ? "up" : v <= 0.4 ? "down" : "yellow"})` : "transparent"}`}></i></div>
              <div class:list={["v", hasV ? sigColor(v) : ""]}>{hasV ? v.toFixed(2) : "—"}</div>
              <div class="raw">
                <b>{m ? s.fmt(m.value) : "—"}</b>
                {m ? `${s.series} ${m.asOf}` : "无读数"}
                {chg !== null && <span class={chg >= 0 ? "up" : "down"}> · 13周 {chg >= 0 ? "+" : ""}{(chg * 100).toFixed(1)}%</span>}
              </div>
            </div>
          );
        })}
        <div class="sep"></div>
        <div class="faint" style="line-height:1.7">
          {sigMeta.map((s) => <div>· <b style="color:var(--text-3)">{s.name}</b>（{s.series}）：{s.desc}</div>)}
          <div style="margin-top:6px">
            百分位读的是"当前相对自己过去 3 年的位置"，所以匀速漂移读数≈0.5，只有<b>加速转变</b>才推向极值——
            这正是低换手的来源。{macro.SP500 && macro.SP500.sma200 ? <>标普 {macro.SP500.value.toFixed(0)} 对 200 日均线 {macro.SP500.sma200.toFixed(0)}，偏离 <b class={macro.SP500.value >= macro.SP500.sma200 ? "up" : "down"}>{((macro.SP500.value / macro.SP500.sma200 - 1) * 100).toFixed(1)}%</b>。</> : ""}
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="panel" style="margin-top:12px">
    <div class="panel-hd">
      <h2>下一轮预告</h2><span class="hint">规则确定性 → 下轮动作可提前算出（npm run agent --dry-run 同源）</span>
      <div class="right">{preview && <span class="faint">截至 {preview.asOf}</span>}</div>
    </div>
    <div class="panel-bd">
      {preview ? (
        <>
          <div class="tiles" style="grid-template-columns:repeat(3,1fr)">
            <div class="tile">
              <div class="tile-k">目标仓位合成</div>
              <div class="tile-v sm">{((preview.composition.final ?? 0) * 100).toFixed(0)}%</div>
              <div class="tile-s">体制 {(preview.composition.regimeTarget * 100).toFixed(0)}% × 波动率 {preview.composition.volMult !== null ? `×${preview.composition.volMult.toFixed(2)}` : "×—"}{preview.composition.tilt !== null ? ` × (1${preview.composition.tilt >= 0 ? "+" : ""}${(preview.composition.tilt * 100).toFixed(1)}%)` : ""}</div>
            </div>
            <div class="tile">
              <div class="tile-k">下轮定投 {preview.nextFriday?.date ?? "—"}</div>
              <div class="tile-v sm">${preview.nextFriday?.injectionUsdt ?? 0}</div>
              <div class="tile-s">{preview.nextFriday?.planned.map((p) => `${p.ticker} $${p.usdt}`).join(" · ") || "—"}</div>
            </div>
            <div class="tile">
              <div class="tile-k">未来 14 天财报</div>
              <div class="tile-v sm">{preview.earningsNext14d.length || "0"} 场</div>
              <div class="tile-s">{preview.earningsNext14d.map((x) => `${x.ticker} ${x.date}`).join(" · ") || "窗口外，无避险动作"}</div>
            </div>
          </div>
          <div class="sep"></div>
          <div class="faint" style="margin-bottom:6px">漂移读数（±{e.drift.thresholdPp}pp 触发拉回；>60% 阈值预标黄）</div>
          {preview.drifts.map((d) => {
            const hot = Math.abs(d.driftPp) > d.thresholdPp;
            const warm = !hot && Math.abs(d.driftPp) > d.thresholdPp * 0.6;
            return (
              <div class="sig" style="grid-template-columns:64px 1fr 90px">
                <div class="n">{d.ticker}</div>
                <div class="bar"><i style={`width:${Math.min(100, (Math.abs(d.driftPp) / (d.thresholdPp * 1.5)) * 100)}%;background:var(--${hot ? "down" : warm ? "yellow" : "blue"})`}></i></div>
                <div class="v" style={`color:var(--${hot ? "down" : warm ? "yellow" : "text-3"})`}>{d.driftPp >= 0 ? "+" : ""}{d.driftPp.toFixed(2)}pp</div>
              </div>
            );
          })}
        </>
      ) : (
        <div class="empty">还没有执行预告 —— 跑一轮 <code>npm run agent</code> 后生成</div>
      )}
    </div>
  </div>

  <div class="panel" style="margin-top:12px">
    <div class="panel-hd">
      <h2>当前持仓</h2><span class="hint">paper · 等权目标 {fmtPct(targetEach, 1)}/只</span>
      <div class="right"><span class="faint">现金 {fmtUsd(cash)}</span></div>
    </div>
    <div class="panel-bd flush grow">
      <table class="tbl fill">
        <thead>
          <tr><th class="l">标的</th><th>持仓</th><th>收盘价</th><th>市值</th><th>权重</th><th>目标</th><th>偏离</th></tr>
        </thead>
        <tbody>
          {rows.map((r) => (
            <tr>
              <td class="l t">
                <div class="sym"><a class="tk" href={`/ticker/${r.ticker}`}>{r.ticker}</a>{inWindow(r.ticker) && <span class="pill earnings">财报窗口</span>}</div>
              </td>
              <td>{r.units.toFixed(4)}</td>
              <td>{r.close.toFixed(2)}</td>
              <td class="strong">{fmtUsd(r.value)}</td>
              <td>{fmtPct(r.weight, 2)}</td>
              <td class="dim">{fmtPct(r.tgt, 2)}</td>
              <td class={Math.abs(r.drift) > e.drift.thresholdPp ? "down strong" : Math.abs(r.drift) > 1 ? "yel" : "dim"}>{r.drift >= 0 ? "+" : ""}{r.drift.toFixed(2)}pp</td>
            </tr>
          ))}
        </tbody>
        <tfoot>
          <tr>
            <td class="l t"><div class="sym"><b>现金</b><i>等待部署</i></div></td>
            <td class="dim">—</td>
            <td class="dim">1.00</td>
            <td class="strong">{fmtUsd(cash)}</td>
            <td>{fmtPct(cashWeight, 2)}</td>
            <td class="dim">{fmtPct(cashTarget, 2)}</td>
            <td class={Math.abs(cashWeight - cashTarget) > e.drift.thresholdPp ? "down strong" : "dim"}>{cashWeight - cashTarget >= 0 ? "+" : ""}{((cashWeight - cashTarget) * 100).toFixed(2)}pp</td>
          </tr>
        </tfoot>
      </table>
    </div>
    <div class="panel-bd" style="padding-top:0">
      <div class="faint" style="line-height:1.65">
        偏离 = 权重 − 目标，|偏离| &gt; ±{e.drift.thresholdPp}pp 触发拉回 · 财报窗口内目标 ×{e.earnings.scaleFactor}（当前 {[...earnWindow.keys()].filter(inWindow).length} 只在窗）·
        现金不计息，随下一轮定投（{nextFriday}）按目标权重部署。
      </div>
    </div>
  </div>

  <div class="panel" style="margin-top:12px">
    <div class="panel-hd">
      <h2>最近交易</h2><span class="hint">paper 执行记录 · 逐笔标注全部触发引擎</span>
      <div class="right">
        <span class:list={["chip", execChip]} title="runtime_state.updated_at：每跑完一轮就写一次，停在上一轮说明守卫拦下了">
          上一轮 {executor ? `${executor.at.slice(5, 16).replace("T", " ")}Z` : "未运行"} · {execAgeLabel}
        </span>
        <a href="/trades" class="chip">全部 {paperTrades.length} 笔 →</a>
      </div>
    </div>
    <div class="panel-bd flush">
      <table class="tbl">
        <thead><tr><th class="l">日期</th><th class="l">标的</th><th class="l">方向</th><th>数量</th><th>金额</th><th class="l">触发引擎</th></tr></thead>
        <tbody>
          {paperTrades.slice(0, 10).map((t) => (
            <tr>
              <td class="l dim">{t.date}</td>
              <td class="l t"><b>{t.ticker}</b></td>
              <td class:list={["l", t.units_delta >= 0 ? "up" : "down"]}>{t.units_delta >= 0 ? "▲ 买入" : "▼ 卖出"}</td>
              <td>{Math.abs(t.units_delta).toFixed(4)}</td>
              <td class="strong">{fmtUsd(t.notional_usdt)}</td>
              <td class="l t">{parseDrivers(t.reason).map((d) => <span class={`pill ${d}`}>{DRIVER_LABEL[d]}</span>)}</td>
            </tr>
          ))}
          {paperTrades.length === 0 && <tr><td colspan="6" class="empty">暂无记录 —— 运行 <code>npm run agent</code></td></tr>}
        </tbody>
      </table>
    </div>
  </div>
</Base>
