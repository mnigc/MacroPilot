---
import Base from "../layouts/Base.astro";
import { ScoreChart, EquityChart } from "../components/charts";
import { regimeBands, REGIME_LABEL } from "../lib/bands";
import { DRIVER_LABEL, parseDrivers } from "../lib/drivers";
import {
  getLatestRun,
  getRegimePoints,
  getTrades,
  getPortfolio,
  getTickerBoard,
  getEarningsCoverage,
  getNextEarnings,
  getMacroReadings,
  getBacktestTurnover,
  getExecutorRun,
  getExecutorPreview,
  getArtifact,
} from "../lib/db";
import { existsSync } from "node:fs";
import { readFileSync } from "node:fs";

const cfg = JSON.parse(readFileSync("../config/strategy.json", "utf8")) as {
  engines: {
    dca: { amountUsdt: number };
    regime: { scoreHigh: number; scoreLow: number; scoreRelease: number; allocation: Record<string, number>; gate?: { sahmThreshold: number }; signals: Record<string, { weight: number }> };
    volTarget?: { targetVol: number };
    drift: { thresholdPp: number };
    earnings: { riskOffDaysBefore: number; scaleFactor: number; restoreDaysAfter: number };
  };
  execution: { startCashUsdt: number };
};

const run = await getLatestRun();
const tickers: string[] = run?.tickers ?? [];
const regimePoints = run ? await getRegimePoints(run.id) : [];
const latest = regimePoints.at(-1) ?? null;
const bands = regimeBands(regimePoints.map((p) => p.date), regimePoints.map((p) => p.regime));

const [board, portfolio, paperTrades, cover, nextEarn, macro, turnover, executor, preview, analog] = await Promise.all([
  getTickerBoard(tickers),
  getPortfolio("paper"),
  getTrades("paper", 200),
  getEarningsCoverage(tickers),
  getNextEarnings(tickers),
  getMacroReadings(),
  run ? getBacktestTurnover(run.id) : Promise.resolve(null),
  getExecutorRun("paper"),
  getExecutorPreview("paper"),
  run ? getArtifact<{ windows: { start: string; end: string; distance: number; fwd63: number | null; fwd126: number | null; fwd252: number | null }[]; asOf: string | null; note: string }>(run.id, "analog") : Promise.resolve(null),
]);
/** 估值锚引擎的数据源是否在位（sync-valuation.py 的产物） */
const capeReady = existsSync("../data/valuation/cape.csv");

const px = Object.fromEntries(board.map((b) => [b.ticker, b]));
const cash = portfolio.find((p) => p.ticker === "CASH")?.units ?? 0;
const holdings = portfolio.filter((p) => p.ticker !== "CASH");
const equity = cash + holdings.reduce((a, p) => a + p.units * (px[p.ticker]?.close ?? 0), 0);
const startCash = cfg.execution.startCashUsdt;
const pnl = equity > 0 ? equity / startCash - 1 : 0;
const cashWeight = equity > 0 ? cash / equity : 0;
const cashTarget = latest ? 1 - latest.equity_target : 0;

const e = cfg.engines;
const targetEach = latest ? latest.equity_target / (tickers.length || 1) : 0;
/** 财报窗口内的标的：前 riskOffDaysBefore 天 ~ 后 restoreDaysAfter 天，目标权重减半 */
const earnWindow = new Map(nextEarn.map((n) => [n.ticker, n]));
const inWindow = (t: string) => {
  const n = earnWindow.get(t);
  return !!n && n.daysAway <= e.earnings.riskOffDaysBefore && n.daysAway >= -e.earnings.restoreDaysAfter;
};
const targetOf = (t: string) => targetEach * (inWindow(t) ? e.earnings.scaleFactor : 1);

const rows = holdings
  .map((p) => {
    const b = px[p.ticker];
    const value = p.units * (b?.close ?? 0);
    const weight = equity > 0 ? value / equity : 0;
    const tgt = targetOf(p.ticker);
    return { ticker: p.ticker, units: p.units, close: b?.close ?? 0, value, weight, tgt, drift: (weight - tgt) * 100, b };
  })
  .sort((a, b) => b.value - a.value);
const maxDrift = rows.reduce((m, r) => Math.max(m, Math.abs(r.drift)), 0);
const drifted = rows.filter((r) => Math.abs(r.drift) > e.drift.thresholdPp).length;

const nextEarnLabel = nextEarn[0] ? `${nextEarn[0].ticker} T-${nextEarn[0].daysAway}` : "—";

const nextFriday = (() => {
  const now = new Date();
  const d = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate()));
  d.setUTCDate(d.getUTCDate() + ((5 - d.getUTCDay() + 7) % 7 || 7));
  return d.toISOString().slice(0, 10);
})();
const dcaCount = paperTrades.filter((t) => parseDrivers(t.reason).includes("dca")).length;

/** 综合分到最近一次切换的边沿距离——"引擎现在离动作有多远" */
const score = latest?.score ?? 0;
const regime = latest?.regime ?? "neutral";
/** 距下一次体制切换的"余量"：极态看回落内沿，中性看最近的外沿。正数=还有距离 */
const edge = (() => {
  if (regime === "riskOn") return { label: "距跌回中性", v: score - e.regime.scoreRelease };
  if (regime === "riskOff") return { label: "距爬回中性", v: e.regime.scoreRelease - score };
  const up = e.regime.scoreHigh - score;
  const down = score - e.regime.scoreLow;
  return up <= down ? { label: "距 risk-on", v: up } : { label: "距 risk-off", v: down };
})();
const switches90 = (() => {
  const cut = new Date(Date.now() - 90 * 86_400_000).toISOString().slice(0, 10);
  let n = 0;
  for (let i = 1; i < regimePoints.length; i++) {
    if (regimePoints[i].date < cut) continue;
    if (regimePoints[i].regime !== regimePoints[i - 1].regime) n++;
  }
  return n;
})();

const sigMeta = [
  { key: "liquidity", name: "流动性", series: "WALCL", w: e.regime.signals.liquidity.weight, desc: "联储资产负债表规模 13 周变化（扩表加分）", fmt: (v: number) => `${(v / 1000).toFixed(0)} 十亿$` },
  { key: "volatility", name: "波动率", series: "VIXCLS", w: e.regime.signals.volatility.weight, desc: "VIX 水平 70% + 1 月趋势 30%（低波动加分）", fmt: (v: number) => v.toFixed(2) },
  { key: "rates", name: "利率", series: "DGS10", w: e.regime.signals.rates.weight, desc: "10Y 收益率 13 周变化（下行加分）", fmt: (v: number) => `${v.toFixed(2)}%` },
  { key: "trend", name: "趋势", series: "SP500", w: e.regime.signals.trend.weight, desc: "标普 500 相对 200 日均线的位置", fmt: (v: number) => v.toFixed(0) },
  { key: "credit", name: "信用", series: "BAMLH0A0HYM2", w: e.regime.signals.credit?.weight ?? 0.2, desc: "高收益信用利差：水平 70% + 13 周变化 30%（收紧减分）", fmt: (v: number) => `${v.toFixed(2)}pp` },
] as const;

const fmtUsd = (v: number) => `$${v.toLocaleString("en-US", { maximumFractionDigits: 2 })}`;
const fmtPct = (v: number, d = 1) => `${(v * 100).toFixed(d)}%`;
const sigColor = (v: number) => (v >= 0.6 ? "up" : v <= 0.4 ? "down" : "yel");
const sigValues: Record<string, number> = latest ? { ...latest.signals } : {};

/**
 * 风险读数。都从库里现算，没有一项是"估算"：
 *  · 回撤/换手来自回测 run（Σ|成交额| 由 SQL 聚合，不能用有 limit 的 getTrades，否则会偏小）。
 */
const years = (() => {
  const s = run?.equity.strategy ?? [];
  const [a, z] = [s[0]?.date, s.at(-1)?.date];
  return a && z ? (Date.parse(z) - Date.parse(a)) / 31_557_600_000 : 0;
})();
const mean = (xs: number[]) => (xs.length ? xs.reduce((a, b) => a + b, 0) / xs.length : 0);
const avgEquity = mean((run?.equity.strategy ?? []).map((p) => p.value));
const avgBench = mean((run?.equity.benchmark ?? []).map((p) => p.value));
/** 年化单边换手 = Σ|成交额| ÷ 2 ÷ 平均净值 ÷ 年数 */
const turnoverStrategy = turnover && years > 0 && avgEquity > 0 ? turnover.gross / 2 / avgEquity / years : null;
/** 买入持有只买不卖，所以它的单边成交额就是累计投入（首笔 + 每周定投） */
const turnoverBench =
  years > 0 && avgBench > 0 ? (startCash + e.dca.amountUsdt * 52 * years) / avgBench / years : null;
const ddShrink = run && run.metrics.benchmark.maxDrawdown ? Math.abs(run.metrics.strategy.maxDrawdown / run.metrics.benchmark.maxDrawdown) : null;

const execAgeH = executor ? (Date.now() - Date.parse(executor.at)) / 3_600_000 : null;
const execChip = execAgeH === null ? "" : execAgeH <= 30 ? "ok" : execAgeH <= 54 ? "warn" : "bad";
const execAgeLabel = execAgeH === null ? "未运行" : execAgeH < 1 ? `${Math.round(execAgeH * 60)} 分钟前` : execAgeH < 48 ? `${execAgeH.toFixed(0)} 小时前` : `${(execAgeH / 24).toFixed(1)} 天前`;

/** 状态行里的数字加粗：string 是说明文字，{b} 是读数 */
type Tok = string | { b: string; cls?: string };

const volMultNow = preview?.composition.volMult ?? null;
const tiltNow = preview?.composition.tilt ?? null;

const engines: { cls: string; name: string; rule: string; icon: string; state: Tok[] }[] = [
  {
    cls: "y", name: "定投引擎", rule: `每周五注入 ${fmtUsd(e.dca.amountUsdt)}，按当期目标权重买入`,
    icon: '<path d="M21 12a9 9 0 1 1-2.64-6.36"/><path d="M21 3v6h-6"/>',
    state: ["下次 ", { b: nextFriday }, " · 已执行 ", { b: String(dcaCount) }, " 次"],
  },
  {
    cls: "g", name: "体制引擎", rule: "五信号百分位加权 → 综合分 → 三态滞回决定总仓位",
    icon: '<circle cx="12" cy="12" r="9"/><path d="M12 12l4.5-4.5"/><path d="M12 21v-3"/>',
    state: [`${REGIME_LABEL[regime]} `, { b: `${((latest?.equity_target ?? 0) * 100).toFixed(0)}%` }, ` · ${edge.label} `, { b: edge.v.toFixed(3) }, " · 近 90 天切换 ", { b: String(switches90) }, " 次"],
  },
  {
    cls: "b", name: "波动率目标", rule: `${e.volTarget ? (e.volTarget.targetVol * 100).toFixed(0) : 15}% 已实现波动之上按比例减仓（不杠杆）`,
    icon: '<path d="M3 3v18h18"/><path d="M7 14l4-4 3 3 5-6"/>',
    state: volMultNow === null
      ? ["乘数 ", { b: "—" }, " · 无读数（按 1 处理）"]
      : ["乘数 ", { b: `×${volMultNow.toFixed(2)}`, cls: volMultNow < 0.9 ? "down" : "up" }, ` · 目标仓位贡献 ${((volMultNow - 1) * 100).toFixed(0)}%`],
  },
  {
    cls: capeReady ? "p" : "w", name: "估值锚", rule: "CAPE 滚动百分位 → ±15% 线性偏移（贵时少买，便宜时多买）",
    icon: '<path d="M12 2v20M2 12h20"/><circle cx="12" cy="12" r="9"/>',
    state: !capeReady
      ? [{ b: "⚠ CAPE 未同步", cls: "down" }, "，引擎按关闭处理"]
      : tiltNow === null
        ? ["偏移 ", { b: "—" }, " · 无读数"]
        : ["偏移 ", { b: `${tiltNow >= 0 ? "+" : ""}${(tiltNow * 100).toFixed(1)}%`, cls: tiltNow >= 0 ? "up" : "down" }, " · 贵时收敛、便宜时扩张"],
  },
  {
    cls: "p", name: "漂移引擎", rule: `任一标的权重偏离目标 ±${e.drift.thresholdPp}pp 即拉回，抑制磨损`,
    icon: '<path d="M4 21v-7M4 10V3M12 21v-9M12 8V3M20 21v-5M20 12V3M1 14h6M9 8h6M17 16h6"/>',
    state: ["最大偏离 ", { b: `${maxDrift.toFixed(2)}pp` }, " · 超阈值 ", { b: String(drifted) }, `/${rows.length} 只`],
  },
  {
    cls: cover.rows === 0 ? "w" : "b", name: "财报引擎", rule: `财报前 ${e.earnings.riskOffDaysBefore} 天该股权重 ×${e.earnings.scaleFactor}，后 ${e.earnings.restoreDaysAfter} 天恢复`,
    icon: '<path d="M12 9v4M12 17h.01"/><path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h16.9a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/>',
    state: cover.rows === 0
      ? [{ b: "⚠ 日历为空", cls: "down" }, "，引擎不会触发"]
      : ["日历 ", { b: String(cover.rows) }, " 条 · 下一场 ", { b: nextEarn[0]?.ticker ?? "—" }, ` T-${nextEarn[0]?.daysAway ?? "—"} · 窗口内 `, { b: String([...earnWindow.keys()].filter(inWindow).length) }, " 只"],
  },
];
---
<Base active="dash" crumb="投顾仪表盘" sub="六模块 → 一张目标权重表 → 一个纸面执行器">
  <div slot="actions" class="stack" style="flex-direction:row;gap:8px">
    <span class:list={["badge", regime]}><span class="dot"></span>{REGIME_LABEL[regime]} · {score.toFixed(3)}</span>
    <span class="chip">纸面账户</span>
  </div>

  <div class="tiles">
    <div class="tile">
      <div class="tile-k">Paper 组合净值</div>
      <div class="tile-v">{fmtUsd(equity)}</div>
      <div class="tile-s"><span class:list={["delta", pnl >= 0 ? "up" : "down"]}>{pnl >= 0 ? "▲" : "▼"} {fmtPct(Math.abs(pnl), 2)}</span> vs 初始 {fmtUsd(startCash)}</div>
    </div>
    <div class="tile">
      <div class="tile-k">目标股票仓位</div>
      <div class="tile-v yel">{((latest?.equity_target ?? 0) * 100).toFixed(0)}%</div>
      <div class="tile-s">体制档 {(e.regime.allocation.riskOn * 100).toFixed(0)}% / {(e.regime.allocation.neutral * 100).toFixed(0)}% / {(e.regime.allocation.riskOff * 100).toFixed(0)}% · 合成 {preview ? `${((preview.composition.final ?? 0) * 100).toFixed(0)}%` : "—"}</div>
    </div>
    <div class="tile">
      <div class="tile-k">资金分布 · 股票 / 现金</div>
      <div class="tile-v sm">{fmtUsd(equity - cash)} <span class="faint">/</span> {fmtUsd(cash)}</div>
      <div class="bar lg" style="margin-top:8px"><i style={`width:${((equity - cash) / (equity || 1)) * 100}%`}></i></div>
    </div>
    <div class="tile">
      <div class="tile-k">下次定投</div>
      <div class="tile-v sm">{nextFriday}</div>
      <div class="tile-s">周五注入 {fmtUsd(e.dca.amountUsdt)} · 已执行 {dcaCount} 次</div>
    </div>
    <div class="tile">
      <div class="tile-k">最近一场财报</div>
      <div class="tile-v sm">{nextEarnLabel}</div>
      <div class="tile-s">{nextEarn[0]?.date ?? "日历未同步"} · 窗口 {e.earnings.riskOffDaysBefore} 天</div>
    </div>
  </div>

  <div class="faint" style="margin:14px 0 6px">
    风险读数 · 与上排同源，全部实测：回测 run #{run?.id ?? "—"}、paper 账本
  </div>
  <div class="tiles">
    <div class="tile">
      <div class="tile-k">最大回撤 · 策略 / 买入持有</div>
      <div class="tile-v down">{run ? fmtPct(run.metrics.strategy.maxDrawdown) : "—"}</div>
      <div class="tile-s">
        基准 {run ? fmtPct(run.metrics.benchmark.maxDrawdown) : "—"} · 峰值回撤压缩到 {ddShrink === null ? "—" : `${(ddShrink * 100).toFixed(0)}%`}
      </div>
    </div>
    <div class="tile">
      <div class="tile-k">年化单边换手</div>
      <div class="tile-v sm">{turnoverStrategy === null ? "—" : `${turnoverStrategy.toFixed(2)}×`}</div>
      <div class="tile-s">
        买入持有 ≈{turnoverBench === null ? "—" : `${turnoverBench.toFixed(2)}×`} · Σ|成交额| ÷ 2 ÷ 平均净值
      </div>
    </div>
  </div>

  {cover.rows === 0 && (
    <div class="note bad" style="margin-top:12px">
      <span class="ic">⚠</span>
      <div><b>财报日历为空</b>（earnings_dates 0 行）——财报引擎不会触发，任何"无临近财报"的读数都不成立。运行 <code>python scripts/sync-prices.py --earnings-only</code> 或由 sync-data workflow 同步。</div>
    </div>
  )}

  <div class="grid g-32" style="margin-top:12px">
    <div class="panel">
      <div class="panel-hd">
        <h2>宏观体制</h2><span class="hint">综合分 = 四信号百分位加权 · 三态滞回</span>
        <div class="right"><span class="faint">截至 {latest?.date ?? "—"}</span></div>
      </div>
      <div class="panel-bd grow">
        <div class="gauge">
        <div class="gauge-score">
          <span class="big">{score.toFixed(3)}</span>
          <span class:list={["badge", regime]}><span class="dot"></span>{REGIME_LABEL[regime]}</span>
          {preview?.gateActive && <span class="chip bad" title={`Sahm 规则读数 ${preview.sahm?.toFixed(2)}pp ≥ 阈值（失业率 3 个月均值 − 12 个月低点）`}>⚠ Sahm 门 · 仓位压回防御档</span>}
          <span class="faint" style="margin-left:auto">{edge.label} <b class="mono">{edge.v.toFixed(3)}</b></span>
        </div>
          <div class="gauge-track">
            <div class="gauge-needle" style={`left:${Math.max(0, Math.min(100, score * 100))}%`}></div>
          </div>
          <div class="gauge-scale">
            <span style="left:0%">0</span>
            <span style={`left:${e.regime.scoreLow * 100}%`}><b>{e.regime.scoreLow.toFixed(2)}</b>risk-off ≤</span>
            <span style={`left:${e.regime.scoreRelease * 100}%`}><b>{e.regime.scoreRelease.toFixed(2)}</b>回落内沿</span>
            <span style={`left:${e.regime.scoreHigh * 100}%`}><b>{e.regime.scoreHigh.toFixed(2)}</b>risk-on ≥</span>
            <span style="left:97%">1</span>
          </div>
        </div>
        <div class="sep"></div>
        <div class="faint" style="margin-bottom:6px">近 180 天综合分与体制色带（绿=risk-on · 蓝=中性 · 红=risk-off）</div>
        <ScoreChart
          client:load
          points={regimePoints.slice(-180).map((p) => ({ date: p.date, score: p.score }))}
          bands={bands.filter((b) => b.end >= (regimePoints.at(-180)?.date ?? "9999"))}
          scoreHigh={e.regime.scoreHigh}
          scoreLow={e.regime.scoreLow}
          scoreRelease={e.regime.scoreRelease}
          short
          fill
        />
      </div>
    </div>

    <div class="panel">
      <div class="panel-hd"><h2>信号分量</h2><span class="hint">百分位 + 原始读数</span></div>
      <div class="panel-bd">
        {sigMeta.map((s) => {
          const v = sigValues[s.key] ?? 0;
          const m = macro[s.series];
          const chg = m?.prevQ ? m.value / m.prevQ - 1 : null;
          return (
            <div class="sig" style="grid-template-columns:88px 1fr 46px 132px">
              <div class="n">{s.name}<em>权重 {fmtPct(s.w, 0)}</em></div>
              <div class="bar lg"><i style={`width:${v * 100}%;background:var(--${v >= 0.6 ? "up" : v <= 0.4 ? "down" : "yellow"})`}></i></div>
              <div class:list={["v", sigColor(v)]}>{v.toFixed(2)}</div>
              <div class="raw">
                <b>{m ? s.fmt(m.value) : "—"}</b>
                {m ? `${s.series} ${m.asOf}` : "无读数"}
                {chg !== null && <span class={chg >= 0 ? "up" : "down"}> · 13周 {chg >= 0 ? "+" : ""}{(chg * 100).toFixed(1)}%</span>}
              </div>
            </div>
          );
        })}
        <div class="sep"></div>
        <div class="faint" style="line-height:1.7">
          {sigMeta.map((s) => <div>· <b style="color:var(--text-3)">{s.name}</b>（{s.series}）：{s.desc}</div>)}
          <div style="margin-top:6px">
            百分位读的是"当前相对自己过去 3 年的位置"，所以匀速漂移读数≈0.5，只有<b>加速转变</b>才推向极值——
            这正是低换手的来源。{macro.SP500 && macro.SP500.sma200 ? <>标普 {macro.SP500.value.toFixed(0)} 对 200 日均线 {macro.SP500.sma200.toFixed(0)}，偏离 <b class={macro.SP500.value >= macro.SP500.sma200 ? "up" : "down"}>{((macro.SP500.value / macro.SP500.sma200 - 1) * 100).toFixed(1)}%</b>。</> : ""}
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="grid g-2" style="margin-top:12px">
    <div class="panel">
      <div class="panel-hd">
        <h2>下一轮预告</h2><span class="hint">规则确定性 → 下轮动作可提前算出（npm run agent --dry-run 同源）</span>
        <div class="right">{preview && <span class="faint">截至 {preview.asOf}</span>}</div>
      </div>
      <div class="panel-bd">
        {preview ? (
          <>
            <div class="tiles" style="grid-template-columns:repeat(3,1fr)">
              <div class="tile">
                <div class="tile-k">目标仓位合成</div>
                <div class="tile-v sm">{((preview.composition.final ?? 0) * 100).toFixed(0)}%</div>
                <div class="tile-s">体制 {(preview.composition.regimeTarget * 100).toFixed(0)}% × 波动率 {preview.composition.volMult !== null ? `×${preview.composition.volMult.toFixed(2)}` : "×—"}{preview.composition.tilt !== null ? ` × (1${preview.composition.tilt >= 0 ? "+" : ""}${(preview.composition.tilt * 100).toFixed(1)}%)` : ""}</div>
              </div>
              <div class="tile">
                <div class="tile-k">下轮定投 {preview.nextFriday?.date ?? "—"}</div>
                <div class="tile-v sm">${preview.nextFriday?.injectionUsdt ?? 0}</div>
                <div class="tile-s">{preview.nextFriday?.planned.map((p) => `${p.ticker} $${p.usdt}`).join(" · ") || "—"}</div>
              </div>
              <div class="tile">
                <div class="tile-k">未来 14 天财报</div>
                <div class="tile-v sm">{preview.earningsNext14d.length || "0"} 场</div>
                <div class="tile-s">{preview.earningsNext14d.map((x) => `${x.ticker} ${x.date}`).join(" · ") || "窗口外，无避险动作"}</div>
              </div>
            </div>
            <div class="sep"></div>
            <div class="faint" style="margin-bottom:6px">漂移读数（±{e.drift.thresholdPp}pp 触发拉回；>60% 阈值预标黄）</div>
            {preview.drifts.map((d) => {
              const hot = Math.abs(d.driftPp) > d.thresholdPp;
              const warm = !hot && Math.abs(d.driftPp) > d.thresholdPp * 0.6;
              return (
                <div class="sig" style="grid-template-columns:64px 1fr 90px">
                  <div class="n">{d.ticker}</div>
                  <div class="bar"><i style={`width:${Math.min(100, (Math.abs(d.driftPp) / (d.thresholdPp * 1.5)) * 100)}%;background:var(--${hot ? "down" : warm ? "yellow" : "blue"})`}></i></div>
                  <div class="v" style={`color:var(--${hot ? "down" : warm ? "yellow" : "text-3"})`}>{d.driftPp >= 0 ? "+" : ""}{d.driftPp.toFixed(2)}pp</div>
                </div>
              );
            })}
          </>
        ) : (
          <div class="empty">还没有执行预告 —— 跑一轮 <code>npm run agent</code> 后生成</div>
        )}
      </div>
    </div>

    <div class="panel">
      <div class="panel-hd">
        <h2>历史类比</h2><span class="hint">宏观综合分形态最像现在的历史窗口 · 之后发生了什么</span>
        <div class="right">{analog?.asOf && <span class="faint">当前窗口截至 {analog.asOf}</span>}</div>
      </div>
      <div class="panel-bd flush">
        {analog && analog.windows.length ? (
          <table class="tbl">
            <thead><tr><th class="l">窗口</th><th>相似度</th><th>后 3 月</th><th>后 6 月</th><th>后 12 月</th></tr></thead>
            <tbody>
              {analog.windows.map((w) => (
                <tr>
                  <td class="l dim">{w.start} → {w.end}</td>
                  <td class="dim">{w.distance.toFixed(3)}</td>
                  <td class={w.fwd63 === null ? "faint" : w.fwd63 >= 0 ? "up" : "down"}>{w.fwd63 === null ? "—" : fmtPct(w.fwd63)}</td>
                  <td class={w.fwd126 === null ? "faint" : w.fwd126 >= 0 ? "up" : "down"}>{w.fwd126 === null ? "—" : fmtPct(w.fwd126)}</td>
                  <td class={w.fwd252 === null ? "faint" : w.fwd252 >= 0 ? "up" : "down"}>{w.fwd252 === null ? "—" : fmtPct(w.fwd252)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        ) : (
          <div class="empty">暂无类比数据 —— 跑一轮 <code>npm run backtest</code> 生成</div>
        )}
      </div>
      <div class="panel-bd" style="padding-top:0">
        <div class="faint" style="line-height:1.65">
          {analog?.note ?? "在综合分历史里找与最近 60 天最相似的窗口，远期收益取买入持有口径。"}这是条件化的历史统计——<b>不是预测</b>。
        </div>
      </div>
    </div>
  </div>

  <div class="grid g-4" style="margin-top:12px">
    {engines.map((eng) => (
      <div class="eng">
        <div class:list={["eng-ic", eng.cls]}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={eng.icon} /></div>
        <div style="min-width:0">
          <h3>{eng.name}</h3>
          <div class="rule">{eng.rule}</div>
          <div class="state">{eng.state.map((tk) => (typeof tk === "string" ? tk : <b class={tk.cls}>{tk.b}</b>))}</div>
        </div>
      </div>
    ))}
  </div>

  <div class="grid g-21" style="margin-top:12px">
    <div class="panel">
      <div class="panel-hd">
        <h2>当前持仓</h2><span class="hint">paper · 等权目标 {fmtPct(targetEach, 1)}/只</span>
        <div class="right"><span class="faint">现金 {fmtUsd(cash)}</span></div>
      </div>
      <div class="panel-bd flush grow">
        <table class="tbl fill">
          <thead>
            <tr><th class="l">标的</th><th>持仓</th><th>收盘价</th><th>市值</th><th>权重</th><th>目标</th><th>偏离</th></tr>
          </thead>
          <tbody>
            {rows.map((r) => (
              <tr>
                <td class="l t">
                  <div class="sym"><a class="tk" href={`/ticker/${r.ticker}`}>{r.ticker}</a>{inWindow(r.ticker) && <span class="pill earnings">财报窗口</span>}</div>
                </td>
                <td>{r.units.toFixed(4)}</td>
                <td>{r.close.toFixed(2)}</td>
                <td class="strong">{fmtUsd(r.value)}</td>
                <td>{fmtPct(r.weight, 2)}</td>
                <td class="dim">{fmtPct(r.tgt, 2)}</td>
                <td class={Math.abs(r.drift) > e.drift.thresholdPp ? "down strong" : Math.abs(r.drift) > 1 ? "yel" : "dim"}>{r.drift >= 0 ? "+" : ""}{r.drift.toFixed(2)}pp</td>
              </tr>
            ))}
          </tbody>
          <tfoot>
            <tr>
              <td class="l t"><div class="sym"><b>现金</b><i>等待部署</i></div></td>
              <td class="dim">—</td>
              <td class="dim">1.00</td>
              <td class="strong">{fmtUsd(cash)}</td>
              <td>{fmtPct(cashWeight, 2)}</td>
              <td class="dim">{fmtPct(cashTarget, 2)}</td>
              <td class={Math.abs(cashWeight - cashTarget) > e.drift.thresholdPp ? "down strong" : "dim"}>{cashWeight - cashTarget >= 0 ? "+" : ""}{((cashWeight - cashTarget) * 100).toFixed(2)}pp</td>
            </tr>
          </tfoot>
        </table>
      </div>
      <div class="panel-bd" style="padding-top:0">
        <div class="faint" style="line-height:1.65">
          偏离 = 权重 − 目标，|偏离| &gt; ±{e.drift.thresholdPp}pp 触发拉回 · 财报窗口内目标 ×{e.earnings.scaleFactor}（当前 {[...earnWindow.keys()].filter(inWindow).length} 只在窗）·
          现金不计息，随下一轮定投（{nextFriday}）按目标权重部署。
        </div>
      </div>
    </div>

    <div class="stack">
      <div class="panel">
        <div class="panel-hd"><h2>财报排程</h2><span class="hint">未来 60 天</span></div>
        <div class="panel-bd flush">
          {nextEarn.length === 0 ? (
            <div class="empty">{cover.rows === 0 ? "财报日历未同步" : "未来 60 天篮子内无财报"}</div>
          ) : (
            <table class="tbl">
              <thead><tr><th class="l">标的</th><th>日期</th><th>倒计时</th><th class="l">引擎动作</th></tr></thead>
              <tbody>
                {nextEarn.map((n) => (
                  <tr>
                    <td class="l t"><b>{n.ticker}</b></td>
                    <td class="dim">{n.date}</td>
                    <td class={n.daysAway <= 5 ? "down strong" : n.daysAway <= 10 ? "yel" : ""}>T-{n.daysAway}</td>
                    <td class="l faint">{inWindow(n.ticker) ? <span class="pill earnings">已减半 ×{e.earnings.scaleFactor}</span> : `前 ${e.earnings.riskOffDaysBefore} 天减半`}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          )}
        </div>
      </div>
      <div class="panel">
        <div class="panel-hd"><h2>体制时间分布</h2><span class="hint">回测 {regimePoints.length.toLocaleString()} 个交易日</span></div>
        <div class="panel-bd">
          {Object.entries(run?.regime_days ?? {}).map(([r, d]) => (
            <div class="sig" style="grid-template-columns:96px 1fr 46px 74px">
              <div class="n">{REGIME_LABEL[r] ?? r}</div>
              <div class="bar"><i style={`width:${(d / (regimePoints.length || 1)) * 100}%;background:var(--${r === "riskOn" ? "up" : r === "riskOff" ? "down" : "blue"})`}></i></div>
              <div class="v">{((d / (regimePoints.length || 1)) * 100).toFixed(0)}%</div>
              <div class="raw"><b>{d.toLocaleString()}</b>天 · {((e.regime.allocation[r] ?? 0) * 100).toFixed(0)}%</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>

  <div class="panel" style="margin-top:12px">
    <div class="panel-hd">
      <h2>最近交易</h2><span class="hint">paper 执行记录 · 逐笔标注全部触发引擎</span>
      <div class="right">
        <span class:list={["chip", execChip]} title="runtime_state.updated_at：每跑完一轮就写一次，停在上一轮说明守卫拦下了">
          上一轮 {executor ? `${executor.at.slice(5, 16).replace("T", " ")}Z` : "未运行"} · {execAgeLabel}
        </span>
        <a href="/trades" class="chip">全部 {paperTrades.length} 笔 →</a>
      </div>
    </div>
    <div class="panel-bd flush">
      <table class="tbl">
        <thead><tr><th class="l">日期</th><th class="l">标的</th><th class="l">方向</th><th>数量</th><th>金额</th><th class="l">触发引擎</th></tr></thead>
        <tbody>
          {paperTrades.slice(0, 10).map((t) => (
            <tr>
              <td class="l dim">{t.date}</td>
              <td class="l t"><b>{t.ticker}</b></td>
              <td class:list={["l", t.units_delta >= 0 ? "up" : "down"]}>{t.units_delta >= 0 ? "▲ 买入" : "▼ 卖出"}</td>
              <td>{Math.abs(t.units_delta).toFixed(4)}</td>
              <td class="strong">{fmtUsd(t.notional_usdt)}</td>
              <td class="l t">{parseDrivers(t.reason).map((d) => <span class={`pill ${d}`}>{DRIVER_LABEL[d]}</span>)}</td>
            </tr>
          ))}
          {paperTrades.length === 0 && <tr><td colspan="6" class="empty">暂无记录 —— 运行 <code>npm run agent</code></td></tr>}
        </tbody>
      </table>
    </div>
  </div>

  <div class="panel" style="margin-top:12px">
    <div class="panel-hd">
      <h2>策略净值 vs 买入持有</h2><span class="hint">同现金流：初始 {fmtUsd(startCash)} + 每周 {fmtUsd(e.dca.amountUsdt)}</span>
      <div class="right">
        <span class="chip">策略夏普 {run?.metrics.strategy.sharpe.toFixed(2)}</span>
        <span class="chip">基准夏普 {run?.metrics.benchmark.sharpe.toFixed(2)}</span>
        <a href="/backtest" class="chip">回测详情 →</a>
      </div>
    </div>
    <div class="panel-bd">{run && <EquityChart client:load strategy={run.equity.strategy} benchmark={run.equity.benchmark} bands={bands} />}</div>
  </div>
</Base>
