---
import Base from "../layouts/Base.astro";
import { EquityChart, ScoreChart, SignalChart, FanChart, RollingChart } from "../components/charts";
import { regimeBands, REGIME_LABEL } from "../lib/bands";
import { getLatestRun, getRegimePoints, getAblationCohort, getArtifact } from "../lib/db";
import { readFileSync } from "node:fs";

const startCashUsdt = (JSON.parse(readFileSync("../config/strategy.json", "utf8")) as {
  execution: { startCashUsdt?: number };
}).execution.startCashUsdt ?? 10_000;

const run = await getLatestRun();
const regimePoints = run ? await getRegimePoints(run.id) : [];
const bands = regimeBands(regimePoints.map((p) => p.date), regimePoints.map((p) => p.regime));
const ablation = await getAblationCohort();

const monthly = run ? await getArtifact<{ strategy: { year: string; months: (number | null)[] }[]; benchmark: { year: string; months: (number | null)[] }[] }>(run.id, "monthly") : null;
const rolling = run ? await getArtifact<{ strategy: { date: string; value: number }[]; benchmark: { date: string; value: number }[] }>(run.id, "rolling") : null;
const bootstrap = run ? await getArtifact<{ strategy: { sharpe: { point: number; lo: number; hi: number }; maxDrawdown: { point: number; lo: number; hi: number } }; benchmark: { sharpe: { point: number; lo: number; hi: number }; maxDrawdown: { point: number; lo: number; hi: number } }; note: string }>(run.id, "bootstrap") : null;
const fan = run ? await getArtifact<{ horizons: number[]; p5: number[]; p25: number[]; p50: number[]; p75: number[]; p95: number[]; drawdownProb: { threshold: number; probability: number }[]; note: string }>(run.id, "fan") : null;
const sensitivity = run ? await getArtifact<{ gridThreshold: { scoreHigh: number; scoreLow: number; sharpe: number; cagr: number; maxDd: number }[]; gridVolDrift: { targetVol: number; driftPp: number; sharpe: number; cagr: number; maxDd: number }[]; note: string }>(run.id, "sensitivity") : null;
const walkforward = run ? await getArtifact<{ folds: { testYear: string; chosen: { scoreHigh: number; scoreLow: number; targetVol: number }; isSharpe: number; oosSharpe: number; oosCagr: number; oosMaxDd: number; baselineOosSharpe: number }[]; note: string }>(run.id, "walkforward") : null;

const params = (run?.params ?? {}) as {
  weights?: Record<string, number>;
  scoreHigh?: number;
  scoreLow?: number;
  scoreRelease?: number;
  allocation?: Record<string, number>;
  gate?: { sahmThreshold: number } | null;
  dcaUsdt?: number;
  driftThresholdPp?: number;
  cost?: { halfSpreadBps: number; impactCoef: number; flatBps: number; earningsMult: number };
  volTarget?: { targetVol: number; lookbackDays: number; floor: number; ceiling: number } | null;
  valuation?: { maxTilt: number; lookbackYears: number } | null;
  cashInterest?: boolean;
  earningsWindow?: { daysBefore: number; daysAfter: number; scale: number };
};

const fmtPct = (v: number, digits = 1) => `${v >= 0 ? "+" : ""}${(v * 100).toFixed(digits)}%`;
/** 仓位/占比不是"涨跌"，不带正负号 —— 和 fmtPct 分开，避免把 100% 目标仓位写成 +100% */
const fmtRatio = (v: number, digits = 0) => `${(v * 100).toFixed(digits)}%`;
const fmtUsd = (v: number) => `$${v.toLocaleString("en-US", { maximumFractionDigits: 0 })}`;
const release = params.scoreRelease ?? ((params.scoreHigh ?? 0.6) + (params.scoreLow ?? 0.3)) / 2;

const period = regimePoints.length ? `${regimePoints[0]?.date} → ${regimePoints.at(-1)?.date}` : "—";
const startCash = startCashUsdt;

/** 三腿对照：策略 vs 买入持有 vs 60/40 */
const compare = run
  ? (
      [
        { k: "总收益", s: run.metrics.strategy.totalReturn, b: run.metrics.benchmark.totalReturn, c: run.metrics.benchmark6040?.totalReturn ?? null, pct: true },
        { k: "年化 CAGR", s: run.metrics.strategy.cagr, b: run.metrics.benchmark.cagr, c: run.metrics.benchmark6040?.cagr ?? null, pct: true },
        { k: "年化波动", s: run.metrics.strategy.annualVol, b: run.metrics.benchmark.annualVol, c: run.metrics.benchmark6040?.annualVol ?? null, pct: true },
        { k: "最大回撤", s: run.metrics.strategy.maxDrawdown, b: run.metrics.benchmark.maxDrawdown, c: run.metrics.benchmark6040?.maxDrawdown ?? null, pct: true },
        { k: "夏普比率", s: run.metrics.strategy.sharpe, b: run.metrics.benchmark.sharpe, c: run.metrics.benchmark6040?.sharpe ?? null, pct: false },
        { k: "Calmar（年化/回撤）", s: run.metrics.strategy.cagr / Math.abs(run.metrics.strategy.maxDrawdown), b: run.metrics.benchmark.cagr / Math.abs(run.metrics.benchmark.maxDrawdown), c: run.metrics.benchmark6040 ? run.metrics.benchmark6040.cagr / Math.abs(run.metrics.benchmark6040.maxDrawdown) : null, pct: false },
      ] as const
    )
  : [];

/** 全年收益 = 各月 (1+r) 连乘 − 1；泛型标注不能出现在模板表达式里（会被当成 HTML 标签解析） */
const compound = (months: (number | null)[]): number | null => {
  let acc: number | null = null;
  for (const m of months) {
    if (m === null) continue;
    acc = acc === null ? 1 + m : acc * (1 + m);
  }
  return acc === null ? null : acc - 1;
};

/** 月度收益单元格底色：|收益| 越大颜色越深，正绿负红 */
const monthCell = (v: number | null): string => {
  if (v === null) return "color:var(--text-4)";
  const a = Math.min(0.55, Math.abs(v) * 4);
  return v >= 0
    ? `background:rgba(14,203,129,${a.toFixed(2)});border-radius:3px`
    : `background:rgba(246,70,93,${a.toFixed(2)});border-radius:3px`;
};

/** 敏感性矩阵：rows × cols → sharpe，颜色按行内极值相对深浅 */
const sensColor = (v: number, lo: number, hi: number): string => {
  const span = hi - lo || 1;
  const t = (v - lo) / span; // 0~1
  const r = Math.round(246 + (14 - 246) * t);
  const g = Math.round(70 + (203 - 70) * t);
  const b = Math.round(93 + (129 - 93) * t);
  return `background:rgba(${r},${g},${b},0.30);border-radius:3px`;
};

/** 按全局历史高点计算逐日回撤，再归集到自然年 —— 与 headline maxDrawdown 同一口径，不另立标准 */
const byYear = (() => {
  if (!run) return [];
  const rows = new Map<string, { year: string; sEnd: number; bEnd: number; sDd: number; bDd: number }>();
  const step = (series: { date: string; value: number }[], key: "sEnd" | "bEnd" | "sDd" | "bDd") => {
    let peak = -Infinity;
    for (const p of series) {
      peak = Math.max(peak, p.value);
      const dd = p.value / peak - 1;
      const y = p.date.slice(0, 4);
      const row = rows.get(y) ?? { year: y, sEnd: 0, bEnd: 0, sDd: 0, bDd: 0 };
      if (key === "sEnd" || key === "bEnd") row[key] = p.value;
      else row[key] = Math.min(row[key], dd);
      rows.set(y, row);
    }
  };
  step(run.equity.strategy, "sEnd");
  step(run.equity.benchmark, "bEnd");
  step(run.equity.strategy, "sDd");
  step(run.equity.benchmark, "bDd");
  return [...rows.values()].sort((a, b) => a.year.localeCompare(b.year));
})();

const switches = (() => {
  let n = 0;
  for (let i = 1; i < regimePoints.length; i++) if (regimePoints[i].regime !== regimePoints[i - 1].regime) n++;
  return n;
})();

const totalDays = regimePoints.length || 1;
const riskOff2022 = regimePoints.filter((p) => p.date.startsWith("2022") && p.regime === "riskOff").length;
const weightRows = Object.entries(run?.final_weights ?? {}).sort((a, b) => b[1] - a[1]);
const regimeColor = (r: string) => (r === "riskOn" ? "up" : r === "riskOff" ? "down" : "blue");

/** 消融表的差值列：本行相对上一行（逐层叠加的边际贡献） */
const ablationRows = ablation.map((row, i) => {
  const prev = i > 0 ? ablation[i - 1] : null;
  return {
    ...row,
    dSharpe: prev ? row.metrics.strategy.sharpe - prev.metrics.strategy.sharpe : null,
    dDd: prev ? row.metrics.strategy.maxDrawdown - prev.metrics.maxDrawdown : null,
    dCagr: prev ? row.metrics.strategy.cagr - prev.metrics.cagr : null,
  };
});

const gateHighs = sensitivity ? [...new Set(sensitivity.gridThreshold.map((g) => g.scoreHigh))].sort((a, b) => b - a) : [];
const gateLows = sensitivity ? [...new Set(sensitivity.gridThreshold.map((g) => g.scoreLow))].sort((a, b) => a - b) : [];
const sensCellA = (h: number, l: number) => sensitivity?.gridThreshold.find((g) => g.scoreHigh === h && g.scoreLow === l);
const volRows = sensitivity ? [...new Set(sensitivity.gridVolDrift.map((g) => g.targetVol))].sort((a, b) => a - b) : [];
const driftCols = sensitivity ? [...new Set(sensitivity.gridVolDrift.map((g) => g.driftPp))].sort((a, b) => a - b) : [];
const sensCellB = (tv: number, dp: number) => sensitivity?.gridVolDrift.find((g) => g.targetVol === tv && g.driftPp === dp);
---
<Base active="backtest" crumb="回测实验室" sub={`真实历史 · 消融可拆 · 统计可证伪 · run #${run?.id ?? "—"}`}>
  <div slot="actions" class="stack" style="flex-direction:row;gap:8px">
    <span class="chip">区间 {period}</span>
    <span class="chip">{regimePoints.length.toLocaleString()} 交易日 · 体制切换 {switches} 次</span>
  </div>

  {run ? (
    <>
      <div class="tiles">
        <div class="tile">
          <div class="tile-k">全引擎策略 · 期末净值</div>
          <div class="tile-v">{fmtUsd(run.equity.strategy.at(-1)?.value ?? 0)}</div>
          <div class="tile-s"><span class:list={["delta", run.metrics.strategy.totalReturn >= 0 ? "up" : "down"]}>{fmtPct(run.metrics.strategy.totalReturn)}</span> · CAGR {fmtPct(run.metrics.strategy.cagr)}</div>
        </div>
        <div class="tile">
          <div class="tile-k">买入持有 · 期末净值</div>
          <div class="tile-v" style="color:var(--text-2)">{fmtUsd(run.equity.benchmark.at(-1)?.value ?? 0)}</div>
          <div class="tile-s"><span class:list={["delta", run.metrics.benchmark.totalReturn >= 0 ? "up" : "down"]}>{fmtPct(run.metrics.benchmark.totalReturn)}</span> · CAGR {fmtPct(run.metrics.benchmark.cagr)}</div>
        </div>
        <div class="tile">
          <div class="tile-k">最大回撤</div>
          <div class="tile-v down">{fmtPct(run.metrics.strategy.maxDrawdown)}</div>
          <div class="tile-s">基准 {fmtPct(run.metrics.benchmark.maxDrawdown)} · <span class="delta up">改善 {((run.metrics.benchmark.maxDrawdown - run.metrics.strategy.maxDrawdown) * 100).toFixed(1)}pp</span></div>
        </div>
        <div class="tile">
          <div class="tile-k">夏普比率</div>
          <div class="tile-v up">{run.metrics.strategy.sharpe.toFixed(2)}</div>
          <div class="tile-s">基准 {run.metrics.benchmark.sharpe.toFixed(2)}{bootstrap ? ` · 95% CI [${bootstrap.strategy.sharpe.lo.toFixed(2)}, ${bootstrap.strategy.sharpe.hi.toFixed(2)}]` : ""}</div>
        </div>
        <div class="tile">
          <div class="tile-k">防御停泊</div>
          <div class="tile-v sm">{run.regime_days.riskOff?.toLocaleString() ?? 0} 天</div>
          <div class="tile-s">占 {fmtRatio((run.regime_days.riskOff ?? 0) / totalDays)} · 仓位 {fmtRatio(params.allocation?.riskOff)}{params.cashInterest ? " · 现金按 DGS3MO 计息" : ""}</div>
        </div>
        <div class="tile">
          <div class="tile-k">现金流假设</div>
          <div class="tile-v sm">{fmtUsd(startCash)} + {fmtUsd(params.dcaUsdt ?? 0)}/周</div>
          <div class="tile-s">逐笔成本（半价差 {params.cost?.halfSpreadBps ?? "—"}bps + √冲击）· 两腿同待遇</div>
        </div>
      </div>

      <div class="grid g-2" style="margin-top:12px">
        <div class="panel">
          <div class="panel-hd"><h2>三腿绩效对照</h2><span class="hint">策略 vs 买入持有 vs 60/40 · 同现金流同成本</span></div>
          <div class="panel-bd flush">
            <table class="tbl">
              <thead><tr><th class="l">指标</th><th>策略</th><th>买入持有</th><th>60/40</th></tr></thead>
              <tbody>
                {compare.map((c) => (
                  <tr>
                    <td class="l t">{c.k}</td>
                    <td class="strong">{c.pct ? fmtPct(c.s) : c.s.toFixed(2)}</td>
                    <td class="dim">{c.pct ? fmtPct(c.b) : c.b.toFixed(2)}</td>
                    <td class="dim">{c.c === null ? "—" : c.pct ? fmtPct(c.c) : c.c.toFixed(2)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <div class="panel-bd" style="padding-top:0">
            <div class="faint" style="line-height:1.65">
              样本区间几乎全程单边牛市，择时的必然代价就是<b>绝对收益少赚</b>。60/40 是"最省事的替代方案"——
              策略必须连它一起赢才算赢。成绩按风险调整口径读：峰值回撤压缩到买入持有的
              <b class="mono">{((Math.abs(run.metrics.strategy.maxDrawdown) / Math.abs(run.metrics.benchmark.maxDrawdown)) * 100).toFixed(0)}%</b>。
            </div>
          </div>
        </div>

        <div class="panel">
          <div class="panel-hd"><h2>引擎消融</h2><span class="hint">逐层叠加 · 差值列 = 本层的边际贡献</span></div>
          <div class="panel-bd flush">
            <table class="tbl">
              <thead><tr><th class="l">配置</th><th>CAGR</th><th>最大回撤</th><th>夏普</th><th>Δ夏普</th></tr></thead>
              <tbody>
                {ablationRows.map((r) => (
                  <tr>
                    <td class="l t"><b>{r.variant}</b></td>
                    <td>{fmtPct(r.metrics.strategy.cagr)}</td>
                    <td class="down">{fmtPct(r.metrics.strategy.maxDrawdown)}</td>
                    <td class="strong">{r.metrics.strategy.sharpe.toFixed(2)}</td>
                    <td class={r.dSharpe === null ? "faint" : r.dSharpe >= 0 ? "up" : "down"}>{r.dSharpe === null ? "—" : `${r.dSharpe >= 0 ? "+" : ""}${r.dSharpe.toFixed(2)}`}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <div class="panel-bd" style="padding-top:0">
            <div class="faint" style="line-height:1.65">
              同一份数据、同一套现金流，只改引擎开关——<b>每个模块值不值得存在由这一张表回答</b>，
              不由直觉回答。Δ夏普为负的层，要么修，要么关。
            </div>
          </div>
        </div>
      </div>

      <div class="panel" style="margin-top:12px">
        <div class="panel-hd">
          <h2>净值曲线</h2><span class="hint">色带 = 宏观体制 · 底部滑块可缩放</span>
          <div class="right"><span class="chip">初始 {fmtUsd(startCash)}</span><span class="chip">每周 {fmtUsd(params.dcaUsdt ?? 0)}</span></div>
        </div>
        <div class="panel-bd"><EquityChart client:load strategy={run.equity.strategy} benchmark={run.equity.benchmark} benchmark6040={run.equity.benchmark6040} bands={bands} tall /></div>
      </div>

      <div class="grid g-2" style="margin-top:12px">
        <div class="panel">
          <div class="panel-hd"><h2>月度收益 · 策略</h2><span class="hint">月末日对月末日（含每周定投入金，读数略被摊薄）· 颜色深浅按 |收益|</span></div>
          <div class="panel-bd flush" style="overflow-x:auto">
            {monthly && (
              <table class="tbl">
                <thead><tr><th class="l">年</th>{Array.from({ length: 12 }, (_, i) => <th>{i + 1}</th>)}<th>全年</th></tr></thead>
                <tbody>
                  {monthly.strategy.map((row) => {
                    const yearRet = compound(row.months);
                    return (
                      <tr>
                        <td class="l t dim">{row.year}</td>
                        {row.months.map((m) => (
                          <td style={monthCell(m)}>{m === null ? "·" : `${(m * 100).toFixed(0)}`}</td>
                        ))}
                        <td class:list={["strong", (yearRet ?? 0) >= 0 ? "up" : "down"]}>{yearRet === null ? "·" : fmtPct(yearRet, 0)}</td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            )}
          </div>
        </div>

        <div class="panel">
          <div class="panel-hd"><h2>滚动 12 个月夏普</h2><span class="hint">零线以下 = 过去一年风险调整后仍在亏</span></div>
          <div class="panel-bd">{rolling && <RollingChart client:load strategy={rolling.strategy} benchmark={rolling.benchmark} />}</div>
        </div>
      </div>

      <div class="grid g-2" style="margin-top:12px">
        <div class="panel">
          <div class="panel-hd"><h2>蒙特卡洛前景（12 个月）</h2><span class="hint">块自助法 · 1000 条路径 · 固定种子可复现</span></div>
          <div class="panel-bd">
            {fan && <FanChart client:load horizons={fan.horizons} p5={fan.p5} p25={fan.p25} p50={fan.p50} p75={fan.p75} p95={fan.p95} />}
            {fan && (
              <div class="sep"></div>
            )}
            {fan && (
              <div class="faint" style="line-height:1.7">
                12 个月内回撤概率（历史分布口径）：
                {fan.drawdownProb.map((d) => (
                  <span style="margin-right:12px">≥{(d.threshold * 100).toFixed(0)}% → <b class="down">{(d.probability * 100).toFixed(0)}%</b></span>
                ))}
                <div style="margin-top:4px">{fan.note}</div>
              </div>
            )}
          </div>
        </div>

        <div class="panel">
          <div class="panel-hd"><h2>置信区间（块自助法）</h2><span class="hint">500 次重采样 · 期望块长 20 交易日</span></div>
          <div class="panel-bd flush">
            {bootstrap && (
              <table class="tbl">
                <thead><tr><th class="l">指标</th><th>策略</th><th>95% CI</th><th>买入持有</th></tr></thead>
                <tbody>
                  <tr>
                    <td class="l t">夏普</td>
                    <td class="strong">{bootstrap.strategy.sharpe.point.toFixed(2)}</td>
                    <td class="dim mono">[{bootstrap.strategy.sharpe.lo.toFixed(2)}, {bootstrap.strategy.sharpe.hi.toFixed(2)}]</td>
                    <td class="dim">{bootstrap.benchmark.sharpe.point.toFixed(2)}</td>
                  </tr>
                  <tr>
                    <td class="l t">最大回撤</td>
                    <td class="strong down">{fmtPct(bootstrap.strategy.maxDrawdown.point)}</td>
                    <td class="dim mono">[{fmtPct(bootstrap.strategy.maxDrawdown.lo)}, {fmtPct(bootstrap.strategy.maxDrawdown.hi)}]</td>
                    <td class="dim">{fmtPct(bootstrap.benchmark.maxDrawdown.point)}</td>
                  </tr>
                </tbody>
              </table>
            )}
          </div>
          <div class="panel-bd" style="padding-top:0">
            {bootstrap && <div class="faint">{bootstrap.note}</div>}
          </div>
        </div>
      </div>

      {(sensitivity || walkforward) && (
        <div class="grid g-2" style="margin-top:12px">
          {sensitivity && (
            <div class="panel">
              <div class="panel-hd"><h2>参数敏感性</h2><span class="hint">夏普热力 · 只在邻域翻脸的结论不配上岗</span></div>
              <div class="panel-bd flush" style="overflow-x:auto">
                <table class="tbl">
                  <thead><tr><th class="l">高\低</th>{gateLows.map((l) => <th>{l}</th>)}</tr></thead>
                  <tbody>
                    {gateHighs.map((h) => {
                      const vals = gateLows.map((l) => sensCellA(h, l)?.sharpe ?? 0);
                      return (
                        <tr>
                          <td class="l t dim">{h}</td>
                          {gateLows.map((l, i) => {
                            const cell = sensCellA(h, l);
                            return <td style={cell ? sensColor(cell.sharpe, Math.min(...vals), Math.max(...vals)) : ""}>{cell ? cell.sharpe.toFixed(2) : "·"}</td>;
                          })}
                        </tr>
                      );
                    })}
                  </tbody>
                </table>
                <div class="sep"></div>
                <table class="tbl">
                  <thead><tr><th class="l">波动目标\漂移</th>{driftCols.map((d) => <th>±{d}pp</th>)}</tr></thead>
                  <tbody>
                    {volRows.map((tv) => {
                      const vals = driftCols.map((d) => sensCellB(tv, d)?.sharpe ?? 0);
                      return (
                        <tr>
                          <td class="l t dim">{(tv * 100).toFixed(0)}%</td>
                          {driftCols.map((d, i) => {
                            const cell = sensCellB(tv, d);
                            return <td style={cell ? sensColor(cell.sharpe, Math.min(...vals), Math.max(...vals)) : ""}>{cell ? cell.sharpe.toFixed(2) : "·"}</td>;
                          })}
                        </tr>
                      );
                    })}
                  </tbody>
                </table>
              </div>
            </div>
          )}
          {walkforward && (
            <div class="panel">
              <div class="panel-hd"><h2>Walk-Forward</h2><span class="hint">只用过去选参，在"未来"年份验证</span></div>
              <div class="panel-bd flush">
                <table class="tbl">
                  <thead><tr><th class="l">OOS 年</th><th class="l">IS 选参</th><th>IS 夏普</th><th>OOS 夏普</th><th>现行参数</th></tr></thead>
                  <tbody>
                    {walkforward.folds.map((f) => (
                      <tr>
                        <td class="l t"><b>{f.testYear}</b></td>
                        <td class="l dim mono">{f.chosen.scoreHigh}/{f.chosen.scoreLow}/v{f.chosen.targetVol}</td>
                        <td>{f.isSharpe.toFixed(2)}</td>
                        <td class={f.oosSharpe >= 0 ? "up" : "down"}>{f.oosSharpe.toFixed(2)}</td>
                        <td class="dim">{f.baselineOosSharpe.toFixed(2)}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
              <div class="panel-bd" style="padding-top:0">
                <div class="faint">{walkforward.note}</div>
              </div>
            </div>
          )}
        </div>
      )}

      <div class="grid g-32" style="margin-top:12px">
        <div class="panel">
          <div class="panel-hd">
            <h2>宏观综合分与体制切换</h2><span class="hint">虚线 = 三个阈值 · 紫色为极态回落内沿</span>
          </div>
          <div class="panel-bd">
            <ScoreChart
              client:load
              points={regimePoints.map((p) => ({ date: p.date, score: p.score }))}
              bands={bands}
              scoreHigh={params.scoreHigh ?? 0.6}
              scoreLow={params.scoreLow ?? 0.3}
              scoreRelease={release}
            />
          </div>
        </div>
        <div class="panel">
          <div class="panel-hd"><h2>体制时间分布</h2><span class="hint">共 {totalDays.toLocaleString()} 个交易日 · 切换 {switches} 次</span></div>
          <div class="panel-bd">
            {Object.entries(run.regime_days).map(([r, d]) => (
              <div class="sig" style="grid-template-columns:96px 1fr 46px 74px">
                <div class="n">{REGIME_LABEL[r] ?? r}</div>
                <div class="bar lg"><i style={`width:${(d / totalDays) * 100}%;background:var(--${regimeColor(r)})`}></i></div>
                <div class="v" style={`color:var(--${regimeColor(r)})`}>{fmtRatio(d / totalDays)}</div>
                <div class="raw"><b>{d.toLocaleString()}</b>天 · {fmtRatio(params.allocation?.[r])}</div>
              </div>
            ))}
            <div class="sep"></div>
            <div class="faint" style="line-height:1.65">
              三态滞回（≥{params.scoreHigh} 进 risk-on · ≤{params.scoreLow} 进 risk-off · 极态回落需越过 {release.toFixed(2)}）
              让引擎在阈值附近<b>不来回摇摆</b>；{params.gate ? `Sahm 确认门 ≥${params.gate.sahmThreshold}pp 时仓位压回防御档；` : ""}
              {switches} 次切换平均每次持有 <b class="mono"> {(regimePoints.length / Math.max(1, switches)).toFixed(0)}</b> 天。
            </div>
          </div>
        </div>
      </div>

      <div class="grid g-21" style="margin-top:12px">
        <div class="panel">
          <div class="panel-hd"><h2>五信号百分位时间线</h2><span class="hint">0.6 / 0.4 是极值参考线，非切换阈值（阈值看综合分）</span></div>
          <div class="panel-bd"><SignalChart client:load points={regimePoints.map((p) => ({ date: p.date, signals: p.signals }))} /></div>
        </div>
        <div class="panel">
          <div class="panel-hd"><h2>策略参数</h2><span class="hint">config/strategy.json · 单一事实源</span></div>
          <div class="panel-bd flush">
            <table class="tbl">
              <tbody>
                <tr><td class="l t dim">信号权重</td><td class="t">流动性 {params.weights?.liquidity} · 波动率 {params.weights?.volatility} · 利率 {params.weights?.rates} · 趋势 {params.weights?.trend} · 信用 {params.weights?.credit ?? "—"}</td></tr>
                <tr><td class="l t dim">切换阈值</td><td class="t">≥{params.scoreHigh} / ≤{params.scoreLow} / 回落 {release.toFixed(2)}{params.gate ? ` · Sahm 门 ≥${params.gate.sahmThreshold}pp` : ""}</td></tr>
                <tr><td class="l t dim">目标仓位</td><td class="t">{fmtRatio(params.allocation?.riskOn)} / {fmtRatio(params.allocation?.neutral)} / {fmtRatio(params.allocation?.riskOff)}</td></tr>
                <tr><td class="l t dim">波动率目标</td><td class="t">{params.volTarget ? `目标 ${(params.volTarget.targetVol * 100).toFixed(0)}% · 回看 ${params.volTarget.lookbackDays} 日 · 乘数 [${params.volTarget.floor}, ${params.volTarget.ceiling}]` : "关闭"}</td></tr>
                <tr><td class="l t dim">估值锚</td><td class="t">{params.valuation ? `CAPE ±${((params.valuation.maxTilt ?? 0) * 100).toFixed(0)}% · 回看 ${params.valuation.lookbackYears} 年` : "关闭"}</td></tr>
                <tr><td class="l t dim">漂移阈值</td><td class="t">±{params.driftThresholdPp}pp</td></tr>
                <tr><td class="l t dim">定投</td><td class="t">{fmtUsd(params.dcaUsdt ?? 0)} / 周五</td></tr>
                <tr><td class="l t dim">财报引擎</td><td class="t">{params.earningsWindow ? `前 ${params.earningsWindow.daysBefore} 天 ×${params.earningsWindow.scale}，后 ${params.earningsWindow.daysAfter} 天恢复 · 已入回测` : "回测关闭"}</td></tr>
                <tr><td class="l t dim">成本模型</td><td class="t">半价差 {params.cost?.halfSpreadBps}bps + 冲击系数 {params.cost?.impactCoef} · 财报窗口 ×{params.cost?.earningsMult}</td></tr>
                <tr><td class="l t dim">现金计息</td><td class="t">{params.cashInterest ? "DGS3MO 日频 · 三腿同待遇" : "关闭"}</td></tr>
              </tbody>
            </table>
          </div>
          <div class="panel-bd" style="padding-top:0">
            <div class="faint">期末权重 {weightRows.map(([t, w]) => `${t} ${(w * 100).toFixed(1)}%`).join(" · ")}</div>
          </div>
        </div>
      </div>

      <div class="grid g-2" style="margin-top:12px">
        <div class="panel">
          <div class="panel-hd"><h2>逐年净值与最深回撤</h2><span class="hint">回撤按历史高点计，与上表同口径</span></div>
          <div class="panel-bd flush">
            <table class="tbl">
              <thead><tr><th class="l">年份</th><th>策略年末</th><th>基准年末</th><th>策略最深回撤</th><th>基准最深回撤</th></tr></thead>
              <tbody>
                {byYear.map((y) => (
                  <tr>
                    <td class="l t">{y.year}</td>
                    <td>{fmtUsd(y.sEnd)}</td>
                    <td class="dim">{fmtUsd(y.bEnd)}</td>
                    <td class="down">{fmtPct(y.sDd)}</td>
                    <td class={y.bDd <= -0.4 ? "down strong" : "down"}>{fmtPct(y.bDd)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <div class="panel-bd" style="padding-top:0">
            <div class="faint" style="line-height:1.65">
              曲线含每周定投注入，年末净值是账户市值而非收益率。缩表 + 高波动那一年，引擎有 <b class="mono">{riskOff2022}</b> 个交易日停在 risk-off、
              目标仓位 {fmtRatio(params.allocation?.riskOff)} —— 风险减半不是靠预测顶部，是靠不满仓过冬。
            </div>
          </div>
        </div>

        <div class="panel">
          <div class="panel-hd"><h2>方法论声明</h2><span class="hint">这份回测能回答什么、不能回答什么</span></div>
          <div class="panel-bd">
            <div class="faint" style="line-height:1.9">
              <div>· <b style="color:var(--text-3)">能</b>：同一规则在同一历史上的相对表现——三腿对照、逐层消融、参数邻域稳定性都是**内比较**，不依赖预测。</div>
              <div>· <b style="color:var(--text-3)">能</b>：历史条件化统计（类比窗口、蒙特卡洛分布）——前提是"未来长得像过去"。</div>
              <div>· <b style="color:var(--text-3)">不能</b>：预测任何具体点位、时间或收益。页面上没有一项输出是预测。</div>
              <div>· 成本模型是估计：半价差按大盘股盘口量级取 {params.cost?.halfSpreadBps}bps，冲击按 √市值模型——真实滑点请用"真实账本"实测校准（trades 页）。</div>
              <div>· 样本只有一轮 2020→今的牛熊：所有结论的可信度以自助法区间与 walk-forward 为界，不以曲线美观为界。</div>
            </div>
          </div>
        </div>
      </div>
    </>
  ) : (
    <div class="panel">
      <div class="empty">还没有回测结果 —— 运行 <code>npm run backtest</code> 后由 CI 写入 backtest_runs</div>
    </div>
  )}
</Base>
