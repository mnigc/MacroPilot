---
import Base from "../layouts/Base.astro";
import { getTrades } from "../lib/db";
import { DRIVER_LABEL, parseDrivers } from "../lib/drivers";

const paperTrades = await getTrades("paper", 200);
const backtestTrades = await getTrades("backtest", 60);

const fmt = (v: number) => `$${Math.abs(v).toLocaleString("en-US", { maximumFractionDigits: 2 })}`;
---
<Base active="trades">
  <div class="hero reveal" style="padding-bottom:0">
    <h1>交易<span class="grad">流水</span></h1>
    <p>每一笔成交标注<b>全部</b>触发引擎 —— 定投 · 体制 · 漂移 · 财报可同日共触发，未来 live 模式的 RFQ 真实成交同样入账</p>
  </div>

  <div class="section-title reveal d1" style="margin-top: 26px">Paper 执行记录 <span class="faint" style="font-weight:400">{paperTrades.length} 笔 · 每次运行 npm run agent 产生</span></div>
  <div class="card reveal d1">
    <table>
      <thead><tr><th>日期</th><th>标的</th><th>方向</th><th>数量（股）</th><th>金额</th><th>触发引擎</th></tr></thead>
      <tbody>
        {paperTrades.map((t) => (
          <tr>
            <td>{t.date}</td>
            <td>{t.ticker}</td>
            <td class={t.units_delta >= 0 ? "up" : "down"}>{t.units_delta >= 0 ? "▲ 买入" : "▼ 卖出"}</td>
            <td>{Math.abs(t.units_delta).toFixed(4)}</td>
            <td>{fmt(t.notional_usdt)}</td>
            <td class="text">{parseDrivers(t.reason).map((d) => <span class={`pill ${d}`}>{DRIVER_LABEL[d]}</span>)}</td>
          </tr>
        ))}
        {paperTrades.length === 0 && <tr><td colspan="6" class="text faint">暂无记录</td></tr>}
      </tbody>
    </table>
  </div>

  <div class="section-title reveal d2">回测成交抽样 <span class="faint" style="font-weight:400">最近 60 笔 · 按日期倒序</span></div>
  <div class="card reveal d2">
    <table>
      <thead><tr><th>日期</th><th>标的</th><th>方向</th><th>金额</th><th>触发引擎</th></tr></thead>
      <tbody>
        {backtestTrades.map((t) => (
          <tr>
            <td>{t.date}</td>
            <td>{t.ticker}</td>
            <td class={t.units_delta >= 0 ? "up" : "down"}>{t.units_delta >= 0 ? "▲ 买入" : "▼ 卖出"}</td>
            <td>{fmt(t.notional_usdt)}</td>
            <td class="text">{parseDrivers(t.reason).map((d) => <span class={`pill ${d}`}>{DRIVER_LABEL[d]}</span>)}</td>
          </tr>
        ))}
        {backtestTrades.length === 0 && <tr><td colspan="5" class="text faint">暂无记录 —— 运行 npm run backtest</td></tr>}
      </tbody>
    </table>
  </div>
  <div class="faint reveal d3" style="margin-top: 10px">完整回测成交序列存于 Postgres trades 表（mode = backtest）；live 模式上线后 RFQ 真实成交将记于 mode = live。</div>
</Base>
